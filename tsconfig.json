{
  "buildOptions": {},
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"],
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "outDir": "build",
    "resolveJsonModule": true
  }
}
